{
  "datasets": [
    {
      "name": "kpi_latest",
      "displayName": "Headcount, latest month (workforce_metrics)",
      "queryLines": [
        "SELECT division, MEASURE(headcount) AS headcount, MEASURE(fte) AS fte\n",
        "FROM workspace.tema_hr_semantic.workforce_metrics\n",
        "WHERE month = '2026-10-31'   -- latest month in the Tema data\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "kpi_ytd",
      "displayName": "Net change since January (workforce_metrics)",
      "queryLines": [
        "SELECT division, MEASURE(hires) AS hires, MEASURE(leavers) AS leavers, MEASURE(net_change) AS net_change\n",
        "FROM workspace.tema_hr_semantic.workforce_metrics\n",
        "WHERE month BETWEEN '2026-01-01' AND '2026-10-31'\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "hc_trend",
      "displayName": "Headcount by month and division (workforce_metrics)",
      "queryLines": [
        "SELECT month, quarter, division, MEASURE(headcount) AS headcount\n",
        "FROM workspace.tema_hr_semantic.workforce_metrics\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "attrition_latest",
      "displayName": "Trailing 12-month attrition by division (retention_metrics)",
      "queryLines": [
        "SELECT division,\n",
        "       MEASURE(attrition_rate_t12m)           AS attrition,\n",
        "       MEASURE(voluntary_attrition_rate_t12m) AS voluntary_attrition,\n",
        "       MEASURE(regretted_attrition_rate_t12m) AS regretted_attrition\n",
        "FROM workspace.tema_hr_semantic.retention_metrics\n",
        "WHERE month = '2026-10-31'\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "hiring_ai_vs_rest",
      "displayName": "Hiring since the AI boom, AI vs rest (talent_acquisition_metrics)",
      "queryLines": [
        "SELECT CASE WHEN is_ai_division THEN 'AI' ELSE 'Rest of Tema' END AS team,\n",
        "       MEASURE(median_time_to_fill_days) AS median_days_to_fill,\n",
        "       MEASURE(offer_acceptance_rate)    AS offer_acceptance\n",
        "FROM workspace.tema_hr_semantic.talent_acquisition_metrics\n",
        "WHERE opened_date >= '2025-05-01' AND status = 'Filled'\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "enps_by_cycle",
      "displayName": "eNPS by survey cycle (experience_metrics)",
      "queryLines": [
        "SELECT survey_cycle, division, MEASURE(enps) AS enps, MEASURE(responses) AS responses\n",
        "FROM workspace.tema_hr_semantic.experience_metrics\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "enps_company",
      "displayName": "eNPS by survey cycle, whole company (experience_metrics)",
      "queryLines": [
        "SELECT survey_cycle, MEASURE(enps) AS enps\n",
        "FROM workspace.tema_hr_semantic.experience_metrics\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "ai_growth",
      "displayName": "AI headcount and regretted attrition by month (two metric views)",
      "queryLines": [
        "SELECT w.month, w.ai_headcount, r.ai_regretted_attrition\n",
        "FROM (SELECT month, MEASURE(headcount) AS ai_headcount\n",
        "      FROM workspace.tema_hr_semantic.workforce_metrics WHERE division = 'AI' GROUP BY ALL) w\n",
        "JOIN (SELECT month, MEASURE(regretted_attrition_rate_t12m) AS ai_regretted_attrition\n",
        "      FROM workspace.tema_hr_semantic.retention_metrics WHERE division = 'AI' GROUP BY ALL) r USING (month)"
      ]
    }
  ],
